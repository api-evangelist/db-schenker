      "properties": {
        "Name": {
          "type": "string"
        },
        "CoAddress": {
          "type": "string"
        },
        "AddressLine1": {
          "type": "string"
        },
        "AddressLine2": {
          "type": "string"
        },
        "City": {
          "type": "string"
        },
        "PostalCode": {
          "type": "string"
        },
        "CountryCode": {
          "type": "string",
          "maxLength": 3,
          "minLength": 2
        }
      },
      "xml": {
        "name": "MailingAddressDTO"
      },
      "type": "object"
    },
    "ContactDTO": {
      "required": [
        "ContactType",
