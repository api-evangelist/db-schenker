        },
        "DeliveryType": {
          "type": "string"
        },
        "Addresses": {
          "items": {
            "$ref": "#/definitions/AddressDTO"
          },
          "xml": {
            "name": "AddressDTO",
            "wrapped": true
          },
          "type": "array"
        },
        "GeoPoint": {
          "$ref": "#/definitions/GeoPointDTO"
        },
        "OpeningHoursShort": {
          "type": "string"
        },
        "OpeningHoursRow1": {
          "type": "string"
        },
        "OpeningHoursRow2": {
          "type": "string"
        },
        "OpeningHoursRow3": {
          "type": "string"
        },
        "OpeningDays": {
          "items": {
